# Oracle Database (Setup only - for export_oracle_schema.py)
DB_HOST=""
DB_PORT=1521
DB_SERVICE=""
DB_USER=""
DB_PASSWORD=""

# Azure OpenAI Embeddings (for utility scripts - can be same endpoint or separate)
AZURE_OPENAI_EMBEDDING_ENDPOINT=""
AZURE_OPENAI_EMBEDDING_API_KEY=""
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-02-01
# Embedding deployment for Azure AI Search hybrid search
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-3-small"
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# Azure Text Analytics for Health (Optional - for utilities)
AZURE_TEXT_ANALYTICS_ENDPOINT=""
AZURE_TEXT_ANALYTICS_KEY=""

# Azure AI Search (Optional - for RAG-based table card retrieval)
AZURE_SEARCH_ENDPOINT=""
AZURE_SEARCH_QUERY_KEY=""
# Admin key only needed for setup/setup_table_cards_index.py (not used by main application)
AZURE_SEARCH_ADMIN_KEY=""
AZURE_SEARCH_TABLE_CARDS_INDEX="sql_assistant_table_cards_index"
HYBRID_SEARCH_ENABLED=true
# Initial retrieval (top 50 from hybrid search)
AZURE_SEARCH_TOP_K=50
# Core table cards selected after reranking
TABLE_CARD_CORE_COUNT=10
# Enable FK relationship expansion
FK_EXPANSION_ENABLED=true
# Expand FK relationships from top N core tables
FK_EXPANSION_SOURCE_COUNT=3
# Maximum total tables after expansion
FK_EXPANSION_MAX_TOTAL=25
# Include reverse FK relationships
FK_EXPANSION_INCLUDE_REVERSE=false

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT="gpt-4o-mini"
AZURE_OPENAI_REGION=
AZURE_OPENAI_MAX_RETRIES=20

# Langfuse Observability (Optional)
LANGFUSE_HOST=""
LANGFUSE_BASE_URL=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
TARGET_SQL_DIALECT="sqlite"
MAX_REPAIR_ATTEMPTS=3

# AWS Configuration
AWS_PROFILE=""
AWS_REGION=eu-central-1
AWS_BEDROCK_MAX_RETRIES=20
BEDROCK_MODEL_ID=""

# Table selector Agent
TABLE_SELECTOR_MODEL_PROVIDER="azure"
TABLE_SELECTOR_MODEL_NAME=
TABLE_SELECTOR_TEMPERATURE="0.0"
# Core tables always shown as "other available" options (safety net for retriever misses)
TABLE_SELECTOR_CORE_TABLES=["ICSR.SAFETY_REPORT","ICSR.PATIENT","ICSR.DRUG","ICSR.REACTION"]
# Value map names to filter out (technical metadata, not useful for LLM reasoning)
TABLE_SELECTOR_NOISE_VALUE_MAPS=["NULL_FLAVOUR","DATE_PRECISION","NULLFLAVOR"]

# SQL Drafter Agent
DRAFTER_MODEL_PROVIDER="azure"
DRAFTER_MODEL_NAME=""
DRAFTER_TEMPERATURE="0.0"

# SQL Repairer Agent
REPAIRER_MODEL_PROVIDER="azure"
REPAIRER_MODEL_NAME=""
REPAIRER_TEMPERATURE="0.0"