AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT="gpt-4o-mini"
AZURE_OPENAI_REGION=
AZURE_OPENAI_MAX_RETRIES=20

# Langfuse Observability (Optional)
LANGFUSE_HOST=
LANGFUSE_BASE_URL=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
TARGET_SQL_DIALECT="sqlite"
MAX_REPAIR_ATTEMPTS=3

# Workflow Configuration
AWS_PROFILE=
AWS_BEDROCK_REGION=
AWS_BEDROCK_MAX_RETRIES=20

# Interpreter Agent
INTERPRETER_MODEL_PROVIDER="azure"
INTERPRETER_MODEL_NAME=
INTERPRETER_TEMPERATURE="0.0"

# SQL Drafter Agent
DRAFTER_MODEL_PROVIDER="azure"
DRAFTER_MODEL_NAME=
DRAFTER_TEMPERATURE="0.0"

# SQL Repairer Agent
REPAIRER_MODEL_PROVIDER="azure"
REPAIRER_MODEL_NAME=
REPAIRER_TEMPERATURE="0.0"

# Azure AI Search (Optional - for RAG-based table card retrieval)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_ADMIN_KEY=
AZURE_SEARCH_QUERY_KEY=
AZURE_SEARCH_TABLE_CARDS_INDEX="sql_assistant_table_cards_index"
AZURE_SEARCH_TOP_K=5