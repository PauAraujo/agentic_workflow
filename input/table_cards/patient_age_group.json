{
  "name": "icsr.patient_age_group",
  "purpose": "Lookup table that defines patient age group categories used in ICSR reporting.",
  "granularity": "One row per age group code.",
  "primary_key": ["PATIENT_AGE_GROUP_ID"],
  "foreign_keys": [],
  "columns": [
    {
      "name": "PATIENT_AGE_GROUP_ID",
      "type": "NUMBER(15,0)",
      "nullable": false,
      "role": ["primary_key", "code"],
      "description": "Unique identifier for the patient age group code."
    },
    {
      "name": "NAME",
      "type": "VARCHAR2(250)",
      "nullable": true,
      "role": ["label"],
      "description": "Label of the age group, for example Foetus or Adult."
    },
    {
      "name": "R2_CODE",
      "type": "NUMBER(15,0)",
      "nullable": true,
      "role": ["mapping", "r2"],
      "description": "Transmission code for this age group as used in ICSR R2."
    },
    {
      "name": "R3_CODE",
      "type": "NUMBER(15,0)",
      "nullable": true,
      "role": ["mapping", "r3"],
      "description": "Transmission code for this age group as used in ICSR R3."
    },
    {
      "name": "R3_CODE_SYSTEM_VERSION",
      "type": "VARCHAR2(10)",
      "nullable": true,
      "role": ["mapping", "version"],
      "description": "Version of the R3 age group code system, for example 2.0."
    }
  ],
  "category_values": [
    { "PATIENT_AGE_GROUP_ID": 1, "NAME": "Foetus", "R2_CODE": null, "R3_CODE": 0, "R3_CODE_SYSTEM_VERSION": "2.0" },
    { "PATIENT_AGE_GROUP_ID": 2, "NAME": "Neonate (Preterm and Term newborns)", "R2_CODE": 1, "R3_CODE": 1, "R3_CODE_SYSTEM_VERSION": "2.0" },
    { "PATIENT_AGE_GROUP_ID": 3, "NAME": "Infant", "R2_CODE": 2, "R3_CODE": 2, "R3_CODE_SYSTEM_VERSION": "2.0" },
    { "PATIENT_AGE_GROUP_ID": 4, "NAME": "Child", "R2_CODE": 3, "R3_CODE": 3, "R3_CODE_SYSTEM_VERSION": "2.0" },
    { "PATIENT_AGE_GROUP_ID": 5, "NAME": "Adolescent", "R2_CODE": 4, "R3_CODE": 4, "R3_CODE_SYSTEM_VERSION": "2.0" },
    { "PATIENT_AGE_GROUP_ID": 6, "NAME": "Adult", "R2_CODE": 5, "R3_CODE": 5, "R3_CODE_SYSTEM_VERSION": "2.0" },
    { "PATIENT_AGE_GROUP_ID": 7, "NAME": "Elderly", "R2_CODE": 6, "R3_CODE": 6, "R3_CODE_SYSTEM_VERSION": "2.0" }
  ],
  "planning_hints": {
    "display_column": "NAME",
    "code_columns": ["PATIENT_AGE_GROUP_ID", "R2_CODE", "R3_CODE"]
  }
}
